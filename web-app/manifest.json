{
  "id": "com.auntie.bee.memorial",
  "name": "Auntie Bee Memorial",
  "short_name": "Auntie Bee",
  "description": "In Loving Memory of Madam Agnes Pomaa – Funeral programme, condolences, tributes and livestream.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "tabbed", "standalone", "minimal-ui", "browser"],
  "background_color": "#111111",
  "theme_color": "#c8a84b",
  "orientation": "portrait",
  "lang": "en",
  "dir": "ltr",
  "categories": ["lifestyle", "social"],
  "prefer_related_applications": false,
  "handle_links": "preferred",
  "iarc_rating_id": "e84b072d-71b3-4d3e-86ae-31a8ce4e53b7",
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "edge_side_panel": {
    "preferred_width": 400
  },
  "scope_extensions": [
    { "origin": "https://auntie-bee.web.app" }
  ],
  "tab_strip": {
    "home_tab": {
      "scope_patterns": [{ "pathname": "/*" }]
    },
    "new_tab_button": {
      "url": "/"
    }
  },
  "note_taking": {
    "new_note_url": "/?page=condolences"
  },
  "share_target": {
    "action": "/",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "protocol_handlers": [
    {
      "protocol": "web+auntiebee",
      "url": "/?protocol=%s"
    }
  ],
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "image/*": [".png", ".jpg", ".jpeg", ".gif", ".webp"]
      }
    }
  ],
  "related_applications": [],
  "widgets": [
    {
      "name": "Auntie Bee Memorial",
      "description": "Quick access to Auntie Bee Memorial",
      "tag": "auntie-bee-widget",
      "template": "generic-template",
      "ms_ac_template": "widgets/template.json",
      "data": "widgets/data.json",
      "type": "application/json",
      "screenshots": [
        {
          "src": "screenshots/screenshot-mobile.png",
          "sizes": "390x844",
          "label": "Auntie Bee Memorial Widget"
        }
      ],
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ],
      "auth": false,
      "update": 86400
    }
  ],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "screenshots/screenshot-mobile.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Home screen – Auntie Bee Memorial",
      "platform": "android"
    },
    {
      "src": "screenshots/screenshot-wide.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Funeral Programme – Auntie Bee Memorial",
      "platform": "windows"
    }
  ],
  "shortcuts": [
    {
      "name": "Condolences",
      "short_name": "Condolences",
      "description": "Leave a condolence message",
      "url": "/?page=condolences",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Register Attendance",
      "short_name": "Attend",
      "description": "Register your attendance",
      "url": "/?page=attend",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Livestream",
      "short_name": "Livestream",
      "description": "Watch the funeral livestream",
      "url": "/?page=livestream",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}