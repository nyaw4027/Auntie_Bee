{
  "id": "/",
  "name": "Auntie Bee Memorial",
  "short_name": "Auntie Bee",
  "description": "In Loving Memory of Madam Agnes Pomaa \u2013 Funeral programme, condolences, tributes and livestream.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "background_color": "#111111",
  "theme_color": "#c8a84b",
  "orientation": "portrait",
  "lang": "en",
  "dir": "ltr",
  "categories": ["lifestyle", "social"],
  "prefer_related_applications": false,
  "related_applications": [],

  "launch_handler": { "client_mode": "navigate-existing" },

  "share_target": {
    "action": "/",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  },

  "protocol_handlers": [
    { "protocol": "web+auntiebee", "url": "/?protocol=%s" }
  ],

  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],

  "shortcuts": [
    {
      "name": "Condolences",
      "short_name": "Condolences",
      "description": "Leave a condolence message",
      "url": "/?page=condolences",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Register Attendance",
      "short_name": "Attend",
      "description": "Register your attendance",
      "url": "/?page=attend",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Livestream",
      "short_name": "Livestream",
      "description": "Watch the funeral livestream",
      "url": "/?page=livestream",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}